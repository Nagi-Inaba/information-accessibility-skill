{
  "schema_version": "1.0.0",
  "targets": { "origins": ["http://127.0.0.1:4173", "https://example.com"], "exact_urls": [] },
  "standards_sources": { "origins": [], "exact_urls": [] },
  "methods": ["GET", "HEAD"],
  "redirects": "same_origin_only",
  "subresources": "same_origin",
  "iframes": "same_origin",
  "deny_private_networks": true,
  "allow_localhost_fixture": true,
  "dns": "pinned_per_request",
  "max_response_bytes": 10485760,
  "max_requests": 500,
  "enforcement": "registered_adapter_required"
}
