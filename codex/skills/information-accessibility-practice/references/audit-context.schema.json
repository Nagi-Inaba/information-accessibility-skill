{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "publication",
    "declarant_name",
    "declared_at",
    "rationale",
    "source_artifact_ids",
    "evidence_refs",
    "value"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": [
        "participation",
        "limitation",
        "next_review",
        "independent_audit",
        "dossier"
      ]
    },
    "publication": {
      "enum": [
        "public",
        "internal"
      ]
    },
    "declarant_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "value": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:audit-context:1.0.0",
  "title": "Declared Audit Context",
  "$defs": {
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "path",
        "sha256",
        "captured_at",
        "environment_ref",
        "target_snapshot_id",
        "publication",
        "run_id",
        "target_version",
        "target_ref",
        "target_context_sha256"
      ],
      "properties": {
        "evidence_type": {
          "enum": [
            "dom_snapshot",
            "accessibility_tree",
            "screenshot",
            "interaction_log",
            "network_log",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "environment_ref": {
          "type": "string",
          "pattern": "^ENV-[a-f0-9]{64}$"
        },
        "target_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "const": "private_by_default"
        },
        "run_id": {
          "type": "string",
          "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[A-Z0-9]{8}$"
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "participation"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "perspective",
              "outcome"
            ],
            "properties": {
              "perspective": {
                "enum": [
                  "find",
                  "receive",
                  "understand",
                  "participate",
                  "continue"
                ]
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "not_applicable",
                  "not_tested",
                  "cant_tell"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "limitation"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "next_review"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "owner",
              "condition"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "independent_audit"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "performed",
              "evaluator_independent",
              "scope_method",
              "report_location"
            ],
            "properties": {
              "performed": {
                "type": "boolean"
              },
              "evaluator_independent": {
                "type": "boolean"
              },
              "scope_method": {
                "type": "string"
              },
              "report_location": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dossier"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prepared",
              "responsible_owner",
              "artifacts"
            ],
            "properties": {
              "prepared": {
                "type": "boolean"
              },
              "responsible_owner": {
                "type": "string"
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  ]
}
