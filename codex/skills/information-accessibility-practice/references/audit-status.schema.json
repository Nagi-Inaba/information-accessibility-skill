{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:audit-status:1.0.0",
  "title": "Read-only audit status output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "valid", "run", "artifacts", "coverage", "claim", "next_transitions", "operations", "latest", "warnings", "errors", "recovery"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "valid": {"type": "boolean"},
    "human_review_resolution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "status",
          "reviews"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "single_review",
              "agreement",
              "unresolved_disagreement"
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "review_id",
                "reviewer_id",
                "review_date",
                "outcome",
                "state",
                "supersedes_review_id"
              ],
              "properties": {
                "review_id": {
                  "type": "string"
                },
                "reviewer_id": {
                  "type": "string"
                },
                "review_date": {
                  "type": "string",
                  "format": "date"
                },
                "outcome": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_applicable",
                    "not_tested",
                    "cant_tell"
                  ]
                },
                "state": {
                  "enum": [
                    "active",
                    "superseded"
                  ]
                },
                "supersedes_review_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "finding_retest": {
      "type": "object", "additionalProperties": false, "required": ["basis", "requirements", "findings"],
      "properties": {
        "basis": {"enum": ["successor_declared_human_reviews", "no_successor_comparison"]},
        "requirements": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["requirement_id", "status"],
          "properties": {"requirement_id": {"type": "string"}, "status": {"enum": ["not_recorded", "retest_required", "pending", "pass_declared", "fail_declared", "not_applicable_declared"]}}
        }},
        "findings": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["finding_id", "requirement_ids", "status"],
          "properties": {"finding_id": {"type": "string"}, "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "status": {"enum": ["unmapped", "not_recorded", "retest_required", "related_requirement_failed", "pending", "all_related_requirements_pass_declared", "related_requirements_pass_or_not_applicable_declared"]}}
        }}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema_version", "state", "profile", "revision", "permissions"],
      "properties": {
        "id": {"type": ["string", "null"]}, "schema_version": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"]}, "profile": {"type": ["string", "null"]},
        "revision": {"type": ["integer", "null"], "minimum": 0}, "permissions": {"type": ["object", "null"]},
        "network_scope": {"type": "object"}, "interaction_scope": {"type": "object"}
      }
    },
    "artifacts": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "producer", "sha256", "validation"],
        "properties": {
          "id": {"type": ["string", "null"]}, "type": {"type": ["string", "null"]},
          "producer": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]},
          "validation": {"enum": ["valid", "run_invalid"]}
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_requirements", "human_reviewed", "evaluation"],
      "properties": {
        "profile_requirements": {"type": ["integer", "null"], "minimum": 0},
        "human_reviewed": {"type": ["integer", "null"], "minimum": 0},
        "evaluation": {"type": ["object", "null"]}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["max_tier", "profile_ceiling"],
      "properties": {"max_tier": {"type": ["string", "null"]}, "profile_ceiling": {"type": ["string", "null"]}}
    },
    "next_transitions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "required_artifact_types", "producer_roles", "permitted", "reason"],
        "properties": {
          "from": {"type": "string"}, "to": {"type": "string"},
          "required_artifact_types": {"type": "array", "items": {"type": "string"}},
          "producer_roles": {"type": "array", "items": {"type": "string"}},
          "permitted": {"type": "boolean"}, "reason": {"type": "string"}
        }
      }
    },
    "operations": {
      "type": "object", "additionalProperties": false, "required": ["merge", "report", "retest"],
      "properties": {"merge": {"$ref": "#/$defs/operation"}, "report": {"$ref": "#/$defs/operation"}, "retest": {"$ref": "#/$defs/operation"}}
    },
    "latest": {
      "type": "object", "additionalProperties": false, "required": ["search_scope", "successors", "warnings"],
      "properties": {
        "search_scope": {"enum": ["sibling_json_files_only", "not_scanned_invalid_run"]},
        "successors": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["file", "run_id", "state", "kind"],
          "properties": {"file": {"type": "string"}, "run_id": {"type": "string"}, "state": {"type": "string"}, "kind": {"enum": ["registration", "retest"]}}
        }},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "priority", "status", "as_of", "assignee", "accountable_owner", "due_on",
          "target_release", "blocked_by", "external_issues", "decision_type", "decision_review_on",
          "overdue", "owner_missing", "exception_expired", "exception_review_due", "resolution_claim", "revision", "history"],
        "properties": {
          "finding_id": {"type": "string"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "status": {"enum": ["open", "investigating", "planned", "in_progress", "fixed", "verified", "closed"]},
          "as_of": {"type": "string", "format": "date"},
          "assignee": {"type": ["string", "null"]},
          "accountable_owner": {"type": ["string", "null"]},
          "due_on": {"type": ["string", "null"], "format": "date"},
          "target_release": {"type": ["string", "null"]},
          "blocked_by": {"type": "array", "items": {"type": "string"}},
          "external_issues": {"type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["system", "id"],
            "properties": {"system": {"type": "string"}, "id": {"type": "string"}}
          }},
          "decision_type": {"type": ["string", "null"]},
          "decision_review_on": {"type": ["string", "null"], "format": "date"},
          "overdue": {"type": "boolean"},
          "owner_missing": {"type": "boolean"},
          "exception_expired": {"type": "boolean"},
          "exception_review_due": {"type": "boolean"},
          "resolution_claim": {"enum": ["verified_closure", "not_resolved"]},
          "revision": {"type": "integer", "minimum": 1},
          "history": {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["revision", "status", "updated_at", "decision_type"],
            "properties": {
              "revision": {"type": "integer", "minimum": 1},
              "status": {"type": "string"},
              "updated_at": {"type": "string", "format": "date-time"},
              "decision_type": {"type": ["string", "null"]}
            }
          }}
        }
      }
    },
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "recovery": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "operation": {"type": "object", "additionalProperties": false, "required": ["available", "reason"], "properties": {"available": {"type": "boolean"}, "reason": {"type": "string"}}},
    "warning": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": {
        "code": {"enum": ["invalid_related_run", "divergent_run", "superseded_run", "legacy_read_only", "merge_blocked"]},
        "file": {"type": "string"}, "files": {"type": "array", "items": {"type": "string"}}, "detail": {"type": "string"}
      }
    }
  }
}
