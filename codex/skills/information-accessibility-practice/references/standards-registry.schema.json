{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:standards-registry:1.0.0",
  "title": "Information Accessibility Standards Registry",
  "type": "object",
  "required": [
    "schema_version",
    "last_verified_at",
    "outcomes",
    "claim_tiers",
    "claim_templates",
    "evidence_levels",
    "global_prohibited_claims",
    "profiles",
    "planned_profiles"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "last_verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "claim_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "claim_templates": { "type": "object" },
    "evidence_levels": { "type": "object" },
    "global_prohibited_claims": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "planned_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "localized_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja"],
      "properties": {
        "ja": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_name", "target_scope", "groups"],
          "properties": {
            "display_name": { "type": "string", "minLength": 1 },
            "target_scope": { "type": "string", "minLength": 1 },
            "groups": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "group_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adoption", "source_ids", "label_en", "label_ja", "scope_en", "scope_ja"],
      "properties": {
        "kind": { "enum": ["standard", "organizational_policy"] },
        "adoption": { "enum": ["profile_default", "explicit_only"] },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "label_en": { "type": "string", "minLength": 1 },
        "label_ja": { "type": "string", "minLength": 1 },
        "scope_en": { "type": "string", "minLength": 1 },
        "scope_ja": { "type": "string", "minLength": 1 }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recommended_profile_ids", "guidance"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "recommended_profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "guidance": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "assessment_configuration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "profile_kind": { "enum": ["standard_profile", "organizational_policy_pattern"] },
        "explicit_adoption_required": { "type": "boolean" },
        "localized": { "$ref": "#/$defs/localized_profile" },
        "group_bases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/group_basis" }
        },
        "migration": { "$ref": "#/$defs/migration" },
        "source_context": { "type": "object" },
        "assessment_configuration": { "$ref": "#/$defs/assessment_configuration" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assessment_configuration": {
                "properties": { "active": { "const": true } },
                "required": ["active"]
              }
            },
            "required": ["assessment_configuration"]
          },
          "then": {
            "required": ["profile_kind", "explicit_adoption_required", "localized", "group_bases"]
          }
        }
      ]
    },
    "assessment_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": {
        "active": { "type": "boolean" },
        "requires_web_interaction_evidence": { "type": "boolean" },
        "catalog_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "requirement_id_prefixes"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!(?:__proto__|prototype|constructor)$)[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "label": { "type": "string", "minLength": 1 },
              "requirement_id_prefixes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "active": { "const": true } },
            "required": ["active"]
          },
          "then": {
            "required": ["catalog_keys", "groups", "requires_web_interaction_evidence"]
          }
        }
      ]
    }
  }
}
