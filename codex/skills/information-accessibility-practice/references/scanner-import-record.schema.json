{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:scanner-import-record:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "publication", "importer", "imported_at", "run_id", "target_ref", "target_snapshot_id", "environment_sha256", "raw_result_sha256", "binding_assurance", "configuration", "configuration_assurance", "frame_coverage", "frame_states", "sources", "rows", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0.0" }, "kind": { "const": "scanner-import-record" }, "publication": { "const": "private_by_default" },
    "importer": { "type": "object", "additionalProperties": false, "required": ["id", "version", "accepted_engine_major", "mapping_version", "mapping_sha256"], "properties": {
      "id": { "const": "axe" }, "version": { "const": "1.0.0" }, "accepted_engine_major": { "const": 4 }, "mapping_version": { "const": "1.0.0" }, "mapping_sha256": { "$ref": "#/$defs/hash" }
    } },
    "imported_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[A-Z0-9]{8}$" },
    "target_ref": { "$ref": "#/$defs/text" }, "target_snapshot_id": { "type": "string", "pattern": "^TARGET-[a-f0-9]{64}$" },
    "environment_sha256": { "$ref": "#/$defs/hash" }, "raw_result_sha256": { "$ref": "#/$defs/hash" }, "raw_result_path": { "$ref": "#/$defs/text" },
    "binding_assurance": { "enum": ["declared_saved_capture", "hash_linked_saved_capture", "state_changed_requires_review"] },
    "configuration": { "type": "object" }, "configuration_assurance": { "enum": ["partially_reported", "caller_declared", "package_recorded"] },
    "frame_coverage": { "type": "object" }, "frame_states": { "type": "array", "maxItems": 50, "items": { "type": "object" } },
    "sources": { "type": "array", "minItems": 1, "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false, "required": ["frame", "tool", "executed_at", "environment", "reported_options"], "properties": {
        "frame": { "$ref": "#/$defs/frame" }, "tool": { "type": "object" }, "executed_at": { "type": "string", "format": "date-time" },
        "environment": { "type": "object" }, "reported_options": { "type": ["object", "null"] }
      }
    } },
    "rows": { "type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source_pointer", "rule_id", "source_outcome", "screening_check_id", "mapping_status", "reported_profile_requirement_ids", "reported_act_rule_ids", "help_url", "impact", "confidence", "frame", "target", "html", "failure_summary", "checks", "dedup_key", "source_key", "false_positive_status", "suppression"],
      "properties": {
        "source_pointer": { "$ref": "#/$defs/text" }, "rule_id": { "$ref": "#/$defs/text" },
        "source_outcome": { "enum": ["violations", "incomplete", "passes", "inapplicable"] },
        "screening_check_id": { "type": ["string", "null"], "pattern": "^SCREEN-[A-Z0-9-]+$" },
        "mapping_status": { "enum": ["requires_human_verification", "unsupported_rule_retained"] },
        "reported_profile_requirement_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "reported_act_rule_ids": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "help_url": { "type": ["string", "null"] }, "impact": { "enum": ["minor", "moderate", "serious", "critical", null] },
        "confidence": { "const": "not_estimated" }, "frame": { "$ref": "#/$defs/frame" }, "target": { "type": "array" },
        "html": { "type": ["string", "null"] }, "failure_summary": { "type": ["string", "null"] }, "checks": { "type": ["object", "null"] },
        "dedup_key": { "$ref": "#/$defs/hash" }, "source_key": { "$ref": "#/$defs/hash" },
        "false_positive_status": { "const": "unreviewed" }, "suppression": { "const": "none" }
      }
    } },
    "limitations": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/text" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frame": { "type": "object", "additionalProperties": false, "required": ["path", "url"], "properties": { "path": { "type": "string", "pattern": "^0(?:\\.[0-9]+)*$" }, "url": { "$ref": "#/$defs/text" } } }
  }
}
