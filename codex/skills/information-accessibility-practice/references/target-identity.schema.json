{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:target-identity:1.0.0",
  "title": "Measured private target identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "kind", "target_ref", "observed_at", "captured_at", "publication", "identity", "evidence_bindings", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "type": "string", "pattern": "^TARGET-[a-f0-9]{64}$" },
    "kind": { "enum": ["file", "git", "http", "web_state"] },
    "target_ref": { "$ref": "#/$defs/text" },
    "observed_at": { "type": "string", "format": "date-time" },
    "captured_at": { "type": "string", "format": "date-time" },
    "publication": { "const": "private_by_default" },
    "identity": { "type": "object" },
    "evidence_bindings": { "type": "array", "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false, "required": ["evidence_type", "sha256"],
      "properties": {
        "evidence_type": { "enum": ["dom_snapshot", "accessibility_tree", "screenshot", "interaction_log", "network_log", "other"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    } },
    "limitations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "file" } } }, "then": { "properties": { "identity": { "$ref": "#/$defs/file" } } } },
    { "if": { "properties": { "kind": { "const": "git" } } }, "then": { "properties": { "identity": { "$ref": "#/$defs/git" } } } },
    { "if": { "properties": { "kind": { "const": "http" } } }, "then": { "properties": { "identity": { "$ref": "#/$defs/http" } } } },
    { "if": { "properties": { "kind": { "const": "web_state" } } }, "then": { "properties": { "identity": { "$ref": "#/$defs/web_state" } } } }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git_oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "nullable_text": { "type": ["string", "null"] },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["canonical_path", "size", "sha256"],
      "properties": { "canonical_path": { "$ref": "#/$defs/text" }, "size": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_root", "git_common_directory", "head_commit", "object_format", "selected_paths", "dirty", "dirty_basis", "files"],
      "properties": {
        "repository_root": { "$ref": "#/$defs/text" }, "git_common_directory": { "$ref": "#/$defs/text" },
        "head_commit": { "$ref": "#/$defs/git_oid" }, "object_format": { "enum": ["sha1", "sha256"] },
        "selected_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "dirty": { "type": "boolean" }, "dirty_basis": { "const": "unfiltered_worktree_bytes_and_index" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/git_file" } }
      }
    },
    "git_file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "head_mode", "head_oid", "index_mode", "index_oid", "working_mode", "working_sha256", "working_blob_oid", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/text" },
        "head_mode": { "$ref": "#/$defs/nullable_text" }, "head_oid": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "index_mode": { "$ref": "#/$defs/nullable_text" }, "index_oid": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "working_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "working_mode": { "enum": ["100644", "100755", null] },
        "working_blob_oid": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "size": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "http": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_url", "final_url", "status", "etag", "last_modified", "content_type", "content_encoding", "response_sha256", "size", "redirects", "request_profile"],
      "properties": {
        "requested_url": { "$ref": "#/$defs/text" }, "final_url": { "$ref": "#/$defs/text" }, "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "etag": { "$ref": "#/$defs/nullable_text" }, "last_modified": { "$ref": "#/$defs/nullable_text" },
        "content_type": { "$ref": "#/$defs/nullable_text" }, "content_encoding": { "$ref": "#/$defs/nullable_text" },
        "response_sha256": { "$ref": "#/$defs/sha256" }, "size": { "type": "integer", "minimum": 0 },
        "request_profile": { "const": "credential_free_get_identity_encoding_v1" },
        "redirects": { "type": "array", "maxItems": 5, "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "to", "status"],
          "properties": { "from": { "$ref": "#/$defs/text" }, "to": { "$ref": "#/$defs/text" }, "status": { "enum": [301, 302, 303, 307, 308] } }
        } }
      }
    },
    "web_state": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_path", "bundle_sha256", "requested_url", "final_url", "status", "dom_sha256", "ax_tree_sha256", "environment_sha256", "viewport", "locale", "authentication_state_id", "feature_flags"],
      "properties": {
        "bundle_path": { "$ref": "#/$defs/text" }, "bundle_sha256": { "$ref": "#/$defs/sha256" },
        "requested_url": { "$ref": "#/$defs/text" }, "final_url": { "$ref": "#/$defs/text" },
        "status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "dom_sha256": { "$ref": "#/$defs/sha256" }, "ax_tree_sha256": { "$ref": "#/$defs/sha256" }, "environment_sha256": { "$ref": "#/$defs/sha256" },
        "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {
          "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
        } },
        "locale": { "$ref": "#/$defs/text" }, "authentication_state_id": { "$ref": "#/$defs/text" },
        "feature_flags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
