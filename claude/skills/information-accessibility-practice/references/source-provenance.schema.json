{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:source-provenance:1.0.0",
  "title": "Third-party source provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_at", "notice", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "notice": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publisher",
          "materials",
          "source_urls",
          "imported_fields",
          "terms_url",
          "terms_summary",
          "attribution",
          "modification_status",
          "review_status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "publisher": { "type": "string", "minLength": 1 },
          "materials": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "source_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } },
          "imported_fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "terms_url": { "type": ["string", "null"], "pattern": "^https://" },
          "terms_summary": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string", "minLength": 1 },
          "modification_status": { "enum": ["metadata_only", "original_summary", "verbatim_excerpt_prohibited", "source_not_redistributed"] },
          "review_status": { "enum": ["documented", "needs_source_specific_review", "source_not_redistributed"] }
        }
      }
    }
  }
}
