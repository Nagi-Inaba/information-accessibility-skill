{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:automated-web-scan:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "scan_status", "captured_at", "profile", "target", "environment", "frame_coverage", "policy", "summary", "machine_violations", "review_candidates", "unmapped_findings", "machine_passes", "inapplicable", "evidence", "raw_result_sha256", "interpretation"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "automated-web-scan" },
    "scan_status": { "const": "complete" },
    "captured_at": { "type": "string" },
    "profile": { "type": "object", "required": ["id", "registry_version"] },
    "target": { "type": "object", "required": ["requested_url", "final_url", "http_status", "dom_sha256", "ax_tree_sha256"] },
    "environment": { "type": "object", "required": ["adapter", "browser_version", "viewport", "scanner"] },
    "frame_coverage": { "type": "object", "required": ["attempted", "succeeded", "failed", "skipped", "entries"] },
    "policy": { "type": "object", "required": ["allowed_origins", "blocked_request_count", "reflow_width"] },
    "summary": { "type": "object", "required": ["machine_violations", "review_candidates", "unmapped_findings", "machine_pass_rules", "inapplicable_rules"] },
    "machine_violations": { "type": "array", "items": { "type": "object", "required": ["dedup_key", "kind", "source", "rule_id", "criterion_relation", "profile_requirement_ids", "occurrence_count", "frame", "nodes"] } },
    "review_candidates": { "type": "array", "items": { "type": "object", "required": ["dedup_key", "kind", "source", "rule_id", "criterion_relation", "profile_requirement_ids", "occurrence_count", "frame", "nodes"] } },
    "unmapped_findings": { "type": "array", "items": { "type": "object", "required": ["dedup_key", "kind", "source", "rule_id", "criterion_relation", "profile_requirement_ids", "occurrence_count", "frame", "nodes"] } },
    "machine_passes": { "type": "array", "items": { "type": "object", "required": ["rule_id", "impact", "help", "help_url", "tags"] } },
    "inapplicable": { "type": "array", "items": { "type": "object", "required": ["rule_id", "impact", "help", "help_url", "tags"] } },
    "evidence": { "type": "object", "required": ["dom", "accessibility_tree", "active_element", "focus_path", "reflow", "blocked_requests"] },
    "raw_result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "interpretation": { "type": "string", "minLength": 1 }
  }
}
