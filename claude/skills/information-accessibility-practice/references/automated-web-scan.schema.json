{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:automated-web-scan:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "scan_status", "captured_at", "profile", "target", "environment", "frame_coverage", "policy", "summary", "machine_violations", "review_candidates", "unmapped_findings", "machine_passes", "inapplicable", "evidence", "raw_result_sha256", "interpretation"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "automated-web-scan" },
    "scan_status": { "const": "complete" },
    "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" },
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "registry_version"], "properties": { "id": { "type": "string", "minLength": 1 }, "registry_version": { "type": "string", "minLength": 1 } } },
    "target": { "$ref": "#/$defs/target" },
    "environment": { "$ref": "#/$defs/environment" },
    "frame_coverage": { "$ref": "#/$defs/frameCoverage" },
    "policy": { "type": "object", "additionalProperties": false, "required": ["allowed_origins", "blocked_request_count", "reflow_width"], "properties": { "allowed_origins": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "blocked_request_count": { "type": "integer", "minimum": 0 }, "reflow_width": { "type": "integer", "minimum": 240, "maximum": 1280 } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["machine_violations", "review_candidates", "unmapped_findings", "machine_pass_rules", "inapplicable_rules"], "properties": { "machine_violations": { "type": "integer", "minimum": 0 }, "review_candidates": { "type": "integer", "minimum": 0 }, "unmapped_findings": { "type": "integer", "minimum": 0 }, "machine_pass_rules": { "type": "integer", "minimum": 0 }, "inapplicable_rules": { "type": "integer", "minimum": 0 } } },
    "machine_violations": { "type": "array", "items": { "$ref": "#/$defs/mappedItem" } },
    "review_candidates": { "type": "array", "items": { "$ref": "#/$defs/mappedItem" } },
    "unmapped_findings": { "type": "array", "items": { "$ref": "#/$defs/unmappedItem" } },
    "machine_passes": { "type": "array", "items": { "$ref": "#/$defs/ruleSummary" } },
    "inapplicable": { "type": "array", "items": { "$ref": "#/$defs/ruleSummary" } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["dom", "accessibility_tree", "active_element", "focus_path", "reflow", "blocked_requests"], "properties": { "dom": { "type": "string" }, "accessibility_tree": { "type": "array" }, "active_element": {}, "focus_path": { "type": "array" }, "reflow": { "type": "object" }, "blocked_requests": { "type": "array" } } },
    "raw_result_sha256": { "$ref": "#/$defs/sha256" },
    "interpretation": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": { "type": "object", "additionalProperties": false, "required": ["requested_url", "final_url", "http_status", "dom_sha256", "ax_tree_sha256"], "properties": { "requested_url": { "type": "string" }, "final_url": { "type": "string" }, "http_status": { "type": ["integer", "null"] }, "dom_sha256": { "$ref": "#/$defs/sha256" }, "ax_tree_sha256": { "$ref": "#/$defs/sha256" } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["adapter", "browser_version", "viewport", "scanner"], "properties": { "adapter": { "const": "playwright-chromium" }, "browser_version": { "type": "string", "minLength": 1 }, "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } }, "scanner": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "axe-core" }, "version": { "type": "string", "minLength": 1 } } } },
    "frameCoverage": { "type": "object", "additionalProperties": false, "required": ["attempted", "succeeded", "failed", "skipped", "entries"], "properties": { "attempted": { "type": "integer", "minimum": 0 }, "succeeded": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 }, "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["frame_path", "url", "status", "reason"], "properties": { "frame_path": { "type": "string" }, "url": { "type": "string" }, "status": { "enum": ["succeeded", "failed", "skipped"] }, "reason": { "type": ["string", "null"] } } } } } },
    "node": { "type": "object", "additionalProperties": false, "required": ["targets", "html", "html_truncated", "failure_summary", "failure_summary_truncated"], "properties": { "targets": { "type": "array", "items": { "type": "string" } }, "html": { "type": "string" }, "html_truncated": { "type": "boolean" }, "failure_summary": { "type": "string" }, "failure_summary_truncated": { "type": "boolean" } } },
    "mappedItem": { "type": "object", "additionalProperties": false, "required": ["dedup_key", "kind", "source", "rule_id", "impact", "help", "help_url", "tags", "criterion_relation", "profile_requirement_ids", "occurrence_count", "frame", "nodes"], "properties": { "dedup_key": { "$ref": "#/$defs/sha256" }, "kind": { "enum": ["machine_violation", "review_candidate"] }, "source": { "type": "string" }, "rule_id": { "type": "string" }, "impact": { "type": ["string", "null"] }, "help": { "type": "string" }, "help_url": { "type": ["string", "null"] }, "tags": { "type": "array", "items": { "type": "string" } }, "criterion_relation": { "const": "reference_only" }, "profile_requirement_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:WCAG-2\\.2-(?:ADDITIONAL-)?SC-|JIS-X-8341-3-2016-SC-)[0-9]+(?:\\.[0-9]+){2}$" } }, "occurrence_count": { "type": "integer", "minimum": 1 }, "frame": { "type": "object" }, "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } } } },
    "unmappedItem": { "allOf": [{ "$ref": "#/$defs/mappedItem" }, { "properties": { "kind": { "const": "unmapped_finding" }, "profile_requirement_ids": { "maxItems": 0 } } }] },
    "ruleSummary": { "type": "object", "additionalProperties": false, "required": ["rule_id", "impact", "help", "help_url", "tags"], "properties": { "rule_id": { "type": "string" }, "impact": { "type": ["string", "null"] }, "help": { "type": "string" }, "help_url": { "type": ["string", "null"] }, "tags": { "type": "array", "items": { "type": "string" } } } }
  }
}
