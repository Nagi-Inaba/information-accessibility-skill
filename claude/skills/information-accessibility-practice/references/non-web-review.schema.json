{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:non-web-review:1.0.0",
  "title": "Non-Web participation review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_boundary", "target", "review_date", "checks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "claim_boundary": {"const": "participation_review_only"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "version", "scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$"},
        "kind": {"enum": ["document-slide", "media-content", "event-community", "participation-workflow"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "review_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "perspective", "question", "outcome", "observation", "reviewer_id", "evidence_refs", "improvement", "retest_method"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "perspective": {"enum": ["find", "receive", "understand", "participate", "continue"]},
          "question": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["not_tested", "no_issue_observed", "issue", "cant_tell", "not_applicable"]},
          "observation": {"type": ["string", "null"]},
          "reviewer_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$"},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "improvement": {"type": ["string", "null"]},
          "retest_method": {"type": ["string", "null"]}
        }
      }
    }
  }
}
