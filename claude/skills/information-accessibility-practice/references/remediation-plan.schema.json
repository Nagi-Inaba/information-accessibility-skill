{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:remediation-plan:3.0.0",
  "title": "Information Accessibility Remediation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "basis",
          "requirement_ids",
          "observation_refs",
          "human_review_refs",
          "priority",
          "locations",
          "affected_users",
          "issue"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "verified_failure",
              "unverified_screening_candidate"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "requirement_id"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^ART-[A-Z0-9][A-Z0-9-]{2,63}$"
                },
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "human_review_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "requirement_id"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^ART-[A-Z0-9][A-Z0-9-]{2,63}$"
                },
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "locations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "affected_users": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "verified_failure"
                }
              }
            },
            "then": {
              "properties": {
                "requirement_ids": {
                  "minItems": 1
                },
                "human_review_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "unverified_screening_candidate"
                }
              }
            },
            "then": {
              "properties": {
                "observation_refs": {
                  "minItems": 1
                },
                "human_review_refs": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "items": {
      "type": "array",
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "findings"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "remediation_id",
                "finding_id",
                "proposed_change",
                "verification",
                "residual_limitation"
              ],
              "properties": {
                "remediation_id": {
                  "type": "string",
                  "pattern": "^REM-[A-Z0-9]{8}$"
                },
                "finding_id": {
                  "type": "string",
                  "minLength": 1
                },
                "proposed_change": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "residual_limitation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "remediation_id",
                "basis",
                "requirement_id",
                "source_artifact_ids",
                "priority",
                "location",
                "affected_users",
                "issue",
                "proposed_change",
                "verification",
                "residual_limitation"
              ],
              "properties": {
                "remediation_id": {
                  "type": "string",
                  "pattern": "^REM-[A-Z0-9]{8}$"
                },
                "basis": {
                  "enum": [
                    "verified_failure",
                    "unverified_screening_candidate"
                  ]
                },
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_artifact_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^ART-[A-Z0-9][A-Z0-9-]{2,63}$"
                  }
                },
                "priority": {
                  "enum": [
                    "P0",
                    "P1",
                    "P2"
                  ]
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "affected_users": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "issue": {
                  "type": "string",
                  "minLength": 1
                },
                "proposed_change": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "residual_limitation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "basis": {
                        "const": "verified_failure"
                      }
                    },
                    "required": [
                      "basis"
                    ]
                  },
                  "then": {
                    "properties": {
                      "requirement_id": {
                        "type": "string",
                        "pattern": "^(?!SCREEN-).+$"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "basis": {
                        "const": "unverified_screening_candidate"
                      }
                    },
                    "required": [
                      "basis"
                    ]
                  },
                  "then": {
                    "properties": {
                      "requirement_id": {
                        "type": "string",
                        "pattern": "^SCREEN-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
