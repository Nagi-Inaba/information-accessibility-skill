{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:human-review-record:2.0.0",
  "title": "Portable human review record; identity assurance is derived at verification time",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "context",
    "review",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "origin"
      ],
      "properties": {
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment_id",
            "target",
            "profile",
            "scope",
            "environment"
          ],
          "properties": {
            "assessment_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version_or_commit",
                "urls_or_files"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version_or_commit": {
                  "type": "string",
                  "minLength": 1
                },
                "urls_or_files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "profile": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "registry_version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "registry_version": {
                  "const": "1.0.0"
                }
              }
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "included",
                "excluded",
                "complete_processes",
                "third_party_content",
                "full_pages_reviewed"
              ],
              "properties": {
                "included": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excluded": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "complete_processes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "third_party_content": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "full_pages_reviewed": {
                  "type": "boolean"
                }
              }
            },
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "os",
                "browsers",
                "assistive_technologies",
                "input_modes"
              ],
              "properties": {
                "os": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "browsers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "assistive_technologies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "input_modes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "origin": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "standalone",
                "audit_run"
              ]
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "standalone"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "standalone"
              }
            }
          },
          "else": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "run_id",
              "artifact_id",
              "artifact_sha256",
              "target_binding_sha256",
              "input_artifacts"
            ],
            "properties": {
              "kind": {
                "const": "audit_run"
              },
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "target_binding_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "input_artifacts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifact_id",
                    "sha256"
                  ],
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "declaration",
        "reviewer_name",
        "review_date",
        "identity_authenticated",
        "reviews"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "declaration": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_name": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "format": "date"
        },
        "identity_authenticated": {
          "const": false
        },
        "reviews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/review"
          }
        }
      }
    },
    "attestation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Null for self-declared review; otherwise an independently verified detached Ed25519 attestation. No serialized assurance flags are accepted."
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "procedure_availability",
        "criterion_procedure_ref",
        "generic_method_ref",
        "official_sources",
        "target_specific_evidence",
        "profile_outcome",
        "rationale"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "procedure_availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "criterion_procedure_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^criterion-procedures:[0-9]+\\.[0-9]+\\.[0-9]+#[a-z0-9-]+$"
        },
        "generic_method_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^web-audit-methods:[0-9]+\\.[0-9]+\\.[0-9]+#[a-z0-9-]+$"
        },
        "official_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "target_specific_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "profile_outcome": {
          "enum": [
            "pass",
            "fail",
            "not_applicable",
            "not_tested",
            "cant_tell"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "$ref": "#/$defs/finding"
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "procedure_availability": {
                "const": "available"
              }
            },
            "required": [
              "procedure_availability"
            ]
          },
          "then": {
            "properties": {
              "criterion_procedure_ref": {
                "type": "string",
                "pattern": "^criterion-procedures:[0-9]+\\.[0-9]+\\.[0-9]+#[a-z0-9-]+$"
              },
              "generic_method_ref": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "procedure_availability": {
                "const": "unavailable"
              }
            },
            "required": [
              "procedure_availability"
            ]
          },
          "then": {
            "properties": {
              "criterion_procedure_ref": {
                "const": null
              },
              "generic_method_ref": {
                "type": "string",
                "pattern": "^web-audit-methods:[0-9]+\\.[0-9]+\\.[0-9]+#[a-z0-9-]+$"
              },
              "official_sources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "findings"
            ]
          },
          "then": {
            "properties": {
              "requirement_id": {},
              "procedure_availability": {},
              "criterion_procedure_ref": {},
              "generic_method_ref": {},
              "official_sources": {},
              "target_specific_evidence": {},
              "profile_outcome": {},
              "rationale": {},
              "findings": {}
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "location",
        "affected_users",
        "observation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "affected_users": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "location",
        "observation",
        "captured_at"
      ],
      "properties": {
        "type": {
          "enum": [
            "manual_observation",
            "browser_inspection",
            "keyboard_test",
            "assistive_technology_test",
            "document_structure_inspection",
            "screenshot",
            "log",
            "report",
            "other"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
