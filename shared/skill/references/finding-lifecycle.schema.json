{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:finding-lifecycle:1.0.0",
  "title": "Private finding and remediation lifecycle revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publication", "run_id", "finding_id", "priority", "requirement_ids", "remediation_ids", "revision", "previous", "updated_at", "state"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "publication": { "const": "private_by_default" },
    "run_id": { "type": "string", "minLength": 1 },
    "finding_id": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "remediation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "revision": { "type": "integer", "minimum": 1 },
    "previous": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assignee", "accountable_owner", "due_on", "target_release", "blocked_by", "external_issues", "decision", "closure"],
      "properties": {
        "status": { "enum": ["open", "investigating", "planned", "in_progress", "fixed", "verified", "closed"] },
        "assignee": { "type": ["string", "null"], "minLength": 1 },
        "accountable_owner": { "type": ["string", "null"], "minLength": 1 },
        "due_on": { "type": ["string", "null"], "format": "date" },
        "target_release": { "type": ["string", "null"], "minLength": 1 },
        "blocked_by": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "external_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "id"],
            "properties": {
              "system": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "decision": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type", "approved_by", "rationale", "expires_on", "review_on"],
          "properties": {
            "type": { "enum": ["false_positive", "duplicate", "obsolete", "deferred", "accepted_risk", "exception_granted"] },
            "approved_by": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "expires_on": { "type": ["string", "null"], "format": "date" },
            "review_on": { "type": ["string", "null"], "format": "date" },
            "duplicate_of": { "type": "string", "minLength": 1 }
          }
        },
        "closure": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["change_artifact_id", "retest_run_file", "retest_run_sha256", "verification_file", "verification_sha256"],
          "properties": {
            "change_artifact_id": { "type": "string", "minLength": 1 },
            "retest_run_file": { "type": "string", "minLength": 1 },
            "retest_run_sha256": { "$ref": "#/$defs/sha256" },
            "verification_file": { "type": "string", "minLength": 1 },
            "verification_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
