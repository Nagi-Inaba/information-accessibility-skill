{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:fix-handoff:1.0.0",
  "title": "Authorized fix parameter handoff without execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "authorization_artifact", "remediation_artifact",
    "source_root", "operation", "target", "description", "expected_before_sha256",
    "expected_after_sha256", "command_ids"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[A-Z0-9]{8}$" },
    "authorization_artifact": { "$ref": "#/$defs/artifact_ref" },
    "remediation_artifact": { "$ref": "#/$defs/artifact_ref" },
    "source_root": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["create", "modify", "delete"] },
    "target": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "expected_before_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "expected_after_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "command_ids": { "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" } }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^ART-[A-Z0-9][A-Z0-9-]{2,63}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
