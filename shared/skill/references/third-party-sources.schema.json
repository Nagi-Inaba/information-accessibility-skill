{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:third-party-sources:1.0.0",
  "title": "Third-party metadata provenance and terms review; not a legal clearance",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "checked_on", "original_work_license", "third_party_relicensed_as_mit", "legal_review_status", "licenses", "sources", "resource_bindings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "checked_on": { "type": "string", "format": "date" },
    "original_work_license": { "const": "MIT" },
    "third_party_relicensed_as_mit": { "const": false },
    "legal_review_status": { "const": "not_legally_reviewed" },
    "licenses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/license" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "resource_bindings": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "canonical_sha256", "source_ids"],
      "properties": {
        "path": { "type": "string", "pattern": "^references/[A-Za-z0-9][A-Za-z0-9.-]*\\.json$" },
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_ids": { "$ref": "#/$defs/texts" }
      }
    } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https://" },
    "texts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "url", "archived_file", "sha256", "checked_on"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" }, "url": { "$ref": "#/$defs/url" },
        "archived_file": { "type": ["string", "null"], "pattern": "^references/licenses/[a-z0-9-]+\\.html$" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "checked_on": { "type": "string", "format": "date" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "publisher", "url", "version", "version_url", "imported_fields", "terms_id", "terms_evidence_url", "terms_status", "legal_review_status", "attribution", "modification_notice", "redistribution_notes", "derivative_notice", "reviewed_source_sha256", "checked_on", "report_notice"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" }, "publisher": { "$ref": "#/$defs/text" },
        "url": { "$ref": "#/$defs/url" }, "version": { "$ref": "#/$defs/text" }, "version_url": { "$ref": "#/$defs/url" },
        "imported_fields": { "$ref": "#/$defs/texts" },
        "terms_id": { "type": ["string", "null"] }, "terms_evidence_url": { "type": ["string", "null"], "pattern": "^https://" },
        "terms_status": { "enum": ["primary_source_checked", "reference_only_terms_unreviewed"] },
        "legal_review_status": { "const": "not_legally_reviewed" },
        "attribution": { "$ref": "#/$defs/text" }, "modification_notice": { "$ref": "#/$defs/text" }, "redistribution_notes": { "$ref": "#/$defs/text" },
        "derivative_notice": { "type": ["string", "null"] },
        "reviewed_source_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "checked_on": { "type": "string", "format": "date" }, "report_notice": { "type": "boolean" }
      }
    }
  }
}
