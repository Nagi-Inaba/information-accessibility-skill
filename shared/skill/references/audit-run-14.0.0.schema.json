{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-accessibility:audit-run:14.0.0",
  "title": "Immutable Information Accessibility Audit Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "supersedes_run_id",
    "status",
    "target",
    "target_inventory",
    "profile",
    "scope",
    "environment",
    "inspection_request",
    "permissions",
    "resource_versions",
    "artifact_root",
    "artifacts",
    "history",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "14.0.0"
    },
    "target_inventory": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "target_context_sha256",
        "environment_sha256",
        "publication",
        "snapshots",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "target_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "publication": {
          "const": "private_by_default"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "inspection_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "purpose",
        "deliverables",
        "completion_criteria"
      ],
      "properties": {
        "mode": {
          "enum": [
            "quick",
            "detailed"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "supersedes_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[A-Z0-9]{8}$"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version_or_commit",
        "urls_or_files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version_or_commit": {
          "type": "string",
          "minLength": 1
        },
        "urls_or_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "registry_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "registry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "complete_processes",
        "third_party_content",
        "full_pages_reviewed"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete_processes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "third_party_content": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "full_pages_reviewed": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "browsers",
        "assistive_technologies",
        "input_modes"
      ],
      "properties": {
        "os": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "browsers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assistive_technologies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "network_policy",
        "interaction",
        "interaction_policy",
        "source_write",
        "command_execution",
        "allowed_actions",
        "forbidden_actions"
      ],
      "properties": {
        "network": {
          "enum": [
            "denied",
            "allowlisted"
          ]
        },
        "network_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "interaction": {
          "enum": [
            "read_only",
            "human_supervised"
          ]
        },
        "source_write": {
          "enum": [
            "denied",
            "authorized_only"
          ]
        },
        "command_execution": {
          "enum": [
            "denied",
            "authorized_verification_only"
          ]
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "execute_authorized_verification_commands",
              "human_supervised_interaction",
              "inspect_without_mutation",
              "read_allowlisted_resources",
              "write_authorized_files"
            ]
          }
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "execute_commands",
              "execute_unapproved_commands",
              "network_access",
              "network_outside_allowlist",
              "write_target"
            ]
          }
        },
        "interaction_policy": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "network": {
                "const": "denied"
              }
            },
            "required": [
              "network"
            ]
          },
          "then": {
            "properties": {
              "network_policy": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "network_policy": {
                "$ref": "#/$defs/network_policy"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "denied"
              },
              "interaction": {
                "const": "read_only"
              },
              "source_write": {
                "const": "denied"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "denied"
              },
              "allowed_actions": {
                "const": [
                  "inspect_without_mutation"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_commands",
                  "network_access",
                  "write_target"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "allowlisted"
              },
              "interaction": {
                "const": "read_only"
              },
              "source_write": {
                "const": "denied"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "denied"
              },
              "allowed_actions": {
                "const": [
                  "inspect_without_mutation",
                  "read_allowlisted_resources"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_commands",
                  "network_outside_allowlist",
                  "write_target"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "denied"
              },
              "interaction": {
                "const": "human_supervised"
              },
              "source_write": {
                "const": "denied"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "denied"
              },
              "allowed_actions": {
                "const": [
                  "human_supervised_interaction",
                  "inspect_without_mutation"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_commands",
                  "network_access",
                  "write_target"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "allowlisted"
              },
              "interaction": {
                "const": "human_supervised"
              },
              "source_write": {
                "const": "denied"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "denied"
              },
              "allowed_actions": {
                "const": [
                  "human_supervised_interaction",
                  "inspect_without_mutation",
                  "read_allowlisted_resources"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_commands",
                  "network_outside_allowlist",
                  "write_target"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "denied"
              },
              "interaction": {
                "const": "read_only"
              },
              "source_write": {
                "const": "authorized_only"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "authorized_verification_only"
              },
              "allowed_actions": {
                "const": [
                  "execute_authorized_verification_commands",
                  "inspect_without_mutation",
                  "write_authorized_files"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_unapproved_commands",
                  "network_access"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "allowlisted"
              },
              "interaction": {
                "const": "read_only"
              },
              "source_write": {
                "const": "authorized_only"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "authorized_verification_only"
              },
              "allowed_actions": {
                "const": [
                  "execute_authorized_verification_commands",
                  "inspect_without_mutation",
                  "read_allowlisted_resources",
                  "write_authorized_files"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_unapproved_commands",
                  "network_outside_allowlist"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "denied"
              },
              "interaction": {
                "const": "human_supervised"
              },
              "source_write": {
                "const": "authorized_only"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "authorized_verification_only"
              },
              "allowed_actions": {
                "const": [
                  "execute_authorized_verification_commands",
                  "human_supervised_interaction",
                  "inspect_without_mutation",
                  "write_authorized_files"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_unapproved_commands",
                  "network_access"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network": {
                "const": "allowlisted"
              },
              "interaction": {
                "const": "human_supervised"
              },
              "source_write": {
                "const": "authorized_only"
              }
            },
            "required": [
              "network",
              "interaction",
              "source_write"
            ]
          },
          "then": {
            "properties": {
              "command_execution": {
                "const": "authorized_verification_only"
              },
              "allowed_actions": {
                "const": [
                  "execute_authorized_verification_commands",
                  "human_supervised_interaction",
                  "inspect_without_mutation",
                  "read_allowlisted_resources",
                  "write_authorized_files"
                ]
              },
              "forbidden_actions": {
                "const": [
                  "execute_unapproved_commands",
                  "network_outside_allowlist"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interaction": {
                "const": "read_only"
              }
            }
          },
          "then": {
            "properties": {
              "interaction_policy": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interaction": {
                "const": "human_supervised"
              }
            }
          },
          "then": {
            "properties": {
              "interaction_policy": {
                "$ref": "#/$defs/interaction_policy"
              }
            }
          }
        }
      ]
    },
    "resource_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standards_registry_version",
        "orchestration_registry_version",
        "orchestration_registry_sha256",
        "criteria_catalog_sha256",
        "criterion_procedures_sha256",
        "audit_methods_sha256"
      ],
      "properties": {
        "standards_registry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "orchestration_registry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "orchestration_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "criteria_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "criterion_procedures_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audit_methods_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact_root": {
      "$ref": "#/$defs/relative_path"
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history_entry"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "network_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origins",
        "exact_urls"
      ],
      "properties": {
        "origins": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,4096}$"
          }
        },
        "exact_urls": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,4096}$"
          }
        }
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "targets",
        "standards_sources",
        "methods",
        "redirects",
        "subresources",
        "iframes",
        "deny_private_networks",
        "allow_localhost_fixture",
        "dns",
        "max_response_bytes",
        "max_requests",
        "enforcement"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "targets": {
          "$ref": "#/$defs/network_scope"
        },
        "standards_sources": {
          "$ref": "#/$defs/network_scope"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD"
            ]
          }
        },
        "redirects": {
          "enum": [
            "same_origin_only",
            "allowlisted"
          ]
        },
        "subresources": {
          "enum": [
            "denied",
            "same_origin",
            "declared"
          ]
        },
        "iframes": {
          "enum": [
            "denied",
            "same_origin",
            "declared"
          ]
        },
        "deny_private_networks": {
          "const": true
        },
        "allow_localhost_fixture": {
          "type": "boolean"
        },
        "dns": {
          "const": "pinned_per_request"
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "enforcement": {
          "const": "registered_adapter_required"
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[A-Z0-9]{8}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000-\\u001F]+$"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "path",
        "sha256",
        "producer_role",
        "created_at",
        "validation_status"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifact_id"
        },
        "artifact_type": {
          "$ref": "#/$defs/artifact_type"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_role": {
          "$ref": "#/$defs/role"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "validation_status": {
          "enum": [
            "valid",
            "invalid"
          ]
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "at",
        "actor_role",
        "artifact_ids"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/status"
        },
        "to": {
          "$ref": "#/$defs/status"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "actor_role": {
          "$ref": "#/$defs/role"
        },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_id"
          }
        }
      }
    },
    "interaction_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "supervisor",
        "scope",
        "starts_at",
        "expires_at",
        "approval_mode",
        "allowed_operations",
        "forbidden_operations",
        "requires_per_action_confirmation",
        "enforcement"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "supervisor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "role"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=[\\s\\S]{1,256}$)[\\s\\S]*\\S"
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=[\\s\\S]{1,256}$)[\\s\\S]*\\S"
            }
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,4096}$"
          }
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
